{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(fr|en)/tool/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(fr|en)/category/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(fr|en)/comparatif/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://rtfyfuwfdpnsogovkwai.supabase.co https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'none'; object-src 'none'; base-uri 'self'" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/fr", "permanent": true },
    { "source": "/tool/:slug", "destination": "/fr/tool/:slug", "permanent": true },
    { "source": "/category/:slug", "destination": "/fr/category/:slug", "permanent": true },
    { "source": "/article/:slug", "destination": "/fr/article/:slug", "permanent": true },
    { "source": "/methodology", "destination": "/fr/methodology", "permanent": true },
    { "source": "/blog/:slug", "destination": "/fr/article/:slug", "permanent": true },
    { "source": "/blog", "destination": "/fr", "permanent": true },
    { "source": "/guides", "destination": "/fr", "permanent": true }
  ],
  "rewrites": [
    { "source": "/fr/:path*", "destination": "/index.html" },
    { "source": "/en/:path*", "destination": "/index.html" }
  ]
}
