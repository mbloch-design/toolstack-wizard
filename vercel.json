{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/fr", "permanent": true }
  ],
  "rewrites": [
    { "source": "/fr/:path*", "destination": "/index.html" },
    { "source": "/en/:path*", "destination": "/index.html" },
    { "source": "/methodology", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/guides", "destination": "/index.html" },
    { "source": "/tool/:slug", "destination": "/index.html" },
    { "source": "/article/:slug", "destination": "/index.html" },
    { "source": "/category/:slug", "destination": "/index.html" }
  ]
}
