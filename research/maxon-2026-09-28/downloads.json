    "<p id=\"text-headline\">\n    STAY CONNECTED\n</p>\n<style>\n#text-headline{\ntext-align: center;\nfont-family: 'Rajdhani';\nfont-weight: 600;\nfont-size: 50px;\nline-height: 3.5rem;\n}\n\n@media screen and (max-width: 800px) {\n#text-headline{ \ndisplay: flex;\njustify-content: center;\nfont-size: 50px;\nline-height: 3.5rem;\n}\n}\n\n@media screen and (max-width: 640px) {\n#text-headline{ \ndisplay: flex;\njustify-content: center;\nfont-size: 36px;\nline-height: 2.5rem;\n}\n}\n</style>",
