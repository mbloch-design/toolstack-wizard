  "install": [
    {
      "client": "claude",
      "type": "url",
      "value": "https://mcp.clickup.com/mcp"
    },
    {
      "client": "claude-code",
      "type": "command",
      "value": "claude mcp add --transport http clickup https://mcp.clickup.com/mcp"
    },
    {
      "client": "cursor",
      "type": "url",
      "value": "https://cursor.com/marketplace/clickup"
    },
    {
      "client": "vs-code",
      "type": "command",
      "value": "code --add-mcp '{\"type\":\"http\",\"name\":\"clickup\",\"url\":\"https://mcp.clickup.com/mcp\"}'"
    },
    {
      "client": "any",
      "type": "url",
      "value": "https://mcp.clickup.com/mcp"
    }
