{
  "slug": "clickup-mcp",
  "name": "ClickUp MCP Server",
  "publisher": "ClickUp",
  "official": true,
  "host_tool": "clickup",
  "category": "project-management",
  "summary": {
    "fr": "Le serveur officiel de ClickUp permet à votre assistant de gérer tâches, documents, commentaires, temps passé et messages, en votre nom et avec vos droits. Il peut mettre une tâche à la corbeille et envoyer des messages de chat ; les appels sont plafonnés selon le forfait.",
    "en": "ClickUp's official server lets your assistant manage tasks, docs, comments, time and messages, as you and with your rights. It can send a task to Trash and post chat messages; calls are capped by plan."
  },
  "verified_on": "2026-11-16",
  "transport": "remote",
  "auth": [
    "oauth"
  ],
  "access": "read_write",
  "plan": "all",
  "plan_note": {
    "fr": "Tous les forfaits, y compris Free Forever, avec un plafond d'appels par 24 h : 100 sur Free Forever, jusqu'à 5 000 sur Enterprise.",
    "en": "Every plan, including Free Forever, with a 24-hour call cap: 100 on Free Forever, up to 5,000 on Enterprise."
  },
  "capabilities": [
    {
      "kind": "read",
      "fr": "Lire tâches, documents, commentaires, temps passé et messages",
      "en": "Read tasks, docs, comments, time entries and messages"
    },
    {
      "kind": "write",
      "fr": "Créer et modifier tâches, documents, commentaires et temps passé",
      "en": "Create and edit tasks, docs, comments and time entries"
    },
    {
      "kind": "delete",
      "fr": "Mettre une tâche à la corbeille, supprimer un commentaire",
      "en": "Send a task to Trash, delete a comment"
    },
    {
      "kind": "send",
      "fr": "Envoyer des messages de chat en votre nom",
      "en": "Send chat messages as you"
    }
  ],
  "setup": [
    {
      "assistant": "claude",
      "how": "url"
    },
    {
      "assistant": "chatgpt",
      "how": "plugin"
    },
    {
      "assistant": "other",
      "how": "url"
    }
  ],
  "safeguards": [],
